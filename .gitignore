# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors/IDEs
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.*
!.env.example

# Claude Code's per-machine settings. This is the file an ANTHROPIC_API_KEY or
# other auth env belongs in - .claude/settings.json is the shared, committed
# counterpart, so keep credentials out of that one. Only a machine-global
# ~/.config/git/ignore was covering this before, which a fresh clone or anyone
# else working on the repo doesn't inherit.
.claude/settings.local.json

# Logs
*.log
logs/

# Dependencies / build output (common across ecosystems)
node_modules/
dist/
build/
out/
target/
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# Archives / temp
*.tmp
*.bak
*.zip

# engine/ run output
runs/

# Playwright MCP's own snapshot/trace output (recreated on every run)
.playwright-mcp/

# Install packages
.source/*

# Screenshots pulled out of the game to look at by hand. Regenerable from any
# probe run, and a few MB of PNGs per session.
experiments/game-screen-probe/pics/

# Static HTML rendered from a wiki bundle by .wiki-source/scripts/render-html.mjs.
# Wholly derived from the committed markdown, and its screenshots live under an
# ignored out/ - so a committed copy would be broken in a fresh clone anyway.
# The second rule is the --single output, which embeds those screenshots as data
# URIs and so runs to tens of MB - definitely not something to commit.
wiki-html/
*-wiki.html
*-wiki-*.html

# Recon session output: ontology.json, report.md and a few dozen PNGs per run.
# Already caught by the bare `out/` rule above, but that one is there for build
# artifacts - stated explicitly so this stays ignored if that rule is ever
# narrowed to the places builds actually write to.
experiments/game-ontology/out/
