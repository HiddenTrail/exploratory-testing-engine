# Pick ONE auth method.

# 1. Direct Anthropic API (default)
ANTHROPIC_API_KEY=

# 2. Amazon Bedrock - leave ANTHROPIC_API_KEY empty and set these instead.
# Credentials come from the normal AWS chain (SSO cache, profile, env vars,
# instance role), so there is no key to paste or leak. AWS_REGION is required;
# AWS_PROFILE is optional if your default profile is already the right one.
# ENGINE_USE_BEDROCK=1
# AWS_REGION=eu-west-1
# AWS_PROFILE=
#
# In Bedrock mode the default model is anthropic.claude-sonnet-5 (see
# DEFAULT_BEDROCK_MODEL in engine/client.py). Bedrock's Messages-API endpoint
# doesn't carry claude-sonnet-4-6, so a Bedrock run isn't on the same model as a
# direct-API run: check output.json's model before comparing results.
# Don't pick ids from `aws bedrock list-inference-profiles`: its eu.* / global.*
# profile ids are for the older InvokeModel path and are rejected here. To try a
# model, pass --model and run once; an unavailable id fails fast with a 404.
