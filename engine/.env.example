# Pick ONE auth method.

# 1. Direct Anthropic API (default)
ANTHROPIC_API_KEY=

# 2. Amazon Bedrock - leave ANTHROPIC_API_KEY empty and set these instead.
# Credentials come from the normal AWS chain (SSO cache, profile, env vars,
# instance role), so there is no key to paste or leak. AWS_REGION is required;
# AWS_PROFILE is optional if your default profile is already the right one.
# ENGINE_USE_BEDROCK=1
# AWS_REGION=eu-west-1
# AWS_PROFILE=
#
# In Bedrock mode the default model becomes the region-prefixed inference
# profile for the same underlying model (eu.anthropic.claude-sonnet-4-6), so
# results stay comparable with direct-API runs. List what your account has with:
#   aws bedrock list-inference-profiles --region eu-west-1
# and override with --model if you need a different one.
